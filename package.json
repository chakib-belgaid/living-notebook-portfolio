{
  "name": "living-notebook-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:performance": "node tests/performance.mjs",
    "test:performance:budgets": "node tests/run-performance-budgets.mjs",
    "stills": "node scripts/capture-stills.mjs",
    "still:loading": "node scripts/capture-loading-still.mjs"
  },
  "dependencies": {
    "@tgwf/co2": "^0.19.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "playwright": "1.62.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
